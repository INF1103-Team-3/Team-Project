# Copy to .env and fill in credentials. Do not commit .env.
APP_NAME=BiteFinder
# Required; the code has no hardcoded fallback model.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30

# Set the keys you want selected for round-robin requests, in order.
# Accepts comma-separated values or a JSON array (quote JSON in .env).
# OPENROUTER_API_KEYS='["replace_with_key_1", "replace_with_key_2"]'
OPENROUTER_API_KEYS=
# Optional JSON array or comma/newline-separated file, relative to this folder.
# OPENROUTER_API_KEYS_FILE=secrets/openrouter_keys.json
OPENROUTER_API_KEYS_FILE=
# Legacy single-key fallback, used only when both settings above are empty.
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

# Email verification: configure your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
# starttls (typically port 587) or ssl (typically port 465).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# A bare sender email address, authorized by your SMTP provider.
SMTP_FROM_EMAIL=

# Set true to skip SMTP verification during local testing.
SMTP_BYPASS=false

# Set true for fixed CLI questions without OpenRouter.
AI_BYPASS=false
