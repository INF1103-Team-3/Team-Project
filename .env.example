# Copy this file to .env at the repository root. Do not commit .env.

# Shared OpenRouter key: BRNS uses this key; BIS uses it when neither a key
# list nor a key file is configured.
OPENROUTER_API_KEY=
# Optional Groq API key used independently by BIS and BRNS. At startup,
# BiteFinder fetches the available Groq chat models and appends them to each
# application's fallback chain. Get a key from https://console.groq.com/keys.
GROQ_API_KEY=
# Optional Groq-compatible chat-completions endpoint override.
BITEFINDER_GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# Maximum time for one BRNS provider request and for the complete ranking
# fallback chain. These limits prevent a slow provider from hanging /search.
BRNS_AI_REQUEST_TIMEOUT_SECONDS=12
BRNS_AI_CHAIN_TIMEOUT_SECONDS=45
DEBUG=false

# BIS: profile chatbot
APP_NAME=BiteFinder
# Optional primary model. BIS also owns a Gemini/OpenRouter fallback chain.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30

# Optional BIS key rotation. Accepts comma-separated values or a JSON array.
# OPENROUTER_API_KEYS='["first-key", "second-key"]'
OPENROUTER_API_KEYS=
# Optional JSON array or comma/newline-separated file, relative to BIS/.
# OPENROUTER_API_KEYS_FILE=secrets/openrouter_keys.json
OPENROUTER_API_KEYS_FILE=

# BIS signup and account-resume verification. Bypass only for local testing.
SMTP_HOST=
SMTP_PORT=587
# starttls (typically port 587) or ssl (typically port 465).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_BYPASS=false
# Failed verification attempts reset after this many minutes (set 1 for 1 min).
VERIFICATION_ATTEMPT_RESET_MINUTES=10
AI_BYPASS=false

# BIS and BRNS each use this key through their own AI managers.
GEMINI_API_KEY=
BRC_GEMINI_MODEL=gemini-3.5-flash-lite
BRC_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
BRC_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
BRC_GROQ_MODEL=openai/gpt-oss-20b
BRC_AI_REQUEST_INTERVAL_SECONDS=4.2
BRC_AI_BATCH_SIZE=100
BRC_AI_TIMEOUT_SECONDS=20
BRC_AI_CHAIN_TIMEOUT_SECONDS=45
# BRNS: recommendation and navigation
GOOGLE_MAPS_API_KEY=
# Set false to use the saved BRNS/data/restaurants.json fallback.
USE_LIVE_GOOGLE=true
